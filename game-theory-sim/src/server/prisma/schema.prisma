generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./database.sqlite"
}

model Game {
  id           Int      @id @default(autoincrement())

  playerType   String

  playerPos    String
  board        String
  path         String
  battles      String

  payoffMatrix String

  createdAt    DateTime @default(now())
}

model PresetMap {
  id          Int      @id @default(autoincrement())

  name        String
  difficulty  Int

  board       String

  description String?

  createdAt   DateTime @default(now())
}