generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./database.sqlite"
}

model Game {
  id         Int      @id @default(autoincrement())
  playerType String
  playerPos  String
  path       String
  lastBattle String
  board      String
  createdAt  DateTime @default(now())
}